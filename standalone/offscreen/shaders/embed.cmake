set(result "#pragma once\n#include <cstdint>\nnamespace shaders {\n")
foreach(stage VERT FRAG HYBRID PATH)
    file(READ "${${stage}}" hex HEX)
    string(LENGTH "${hex}" length)
    math(EXPR last "${length} - 8")
    string(APPEND result "inline constexpr uint32_t ${stage}[] = {\n")
    foreach(offset RANGE 0 ${last} 8)
        foreach(byte 3 2 1 0)
            math(EXPR index "${offset} + ${byte} * 2")
            string(SUBSTRING "${hex}" ${index} 2 digit)
            if(byte EQUAL 3)
                string(APPEND result "0x")
            endif()
            string(APPEND result "${digit}")
        endforeach()
        string(APPEND result ",")
    endforeach()
    string(APPEND result "\n};\n")
endforeach()
string(APPEND result "}\n")
file(WRITE "${OUTPUT}" "${result}")
