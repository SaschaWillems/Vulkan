file(MAKE_DIRECTORY "${TEST_DIR}")
execute_process(COMMAND "${RENDERER}" --snapshot WORKING_DIRECTORY "${TEST_DIR}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result STREQUAL "0" OR stderr MATCHES "[[]validation error[]]")
    message(FATAL_ERROR "Rendering failed (${result}):\n${stdout}\n${stderr}")
endif()
set(ppm "${TEST_DIR}/output.ppm")
file(SIZE "${ppm}" size)
file(READ "${ppm}" header LIMIT 17 HEX)
string(HEX "P6\n2560 1440\n255\n" expectedHeader)
if(NOT size EQUAL 11059217 OR NOT header STREQUAL expectedHeader)
    message(FATAL_ERROR "Invalid P6 PPM header or payload size")
endif()
set(background 255 255 255)
foreach(channel RANGE 0 2)
    math(EXPR offset "17 + ${channel}")
    file(READ "${ppm}" hex OFFSET ${offset} LIMIT 1 HEX)
    list(GET background ${channel} expected)
    math(EXPR difference "0x${hex} - ${expected}")
    if(difference LESS -1 OR difference GREATER 1)
        message(FATAL_ERROR "Unexpected clear color")
    endif()
endforeach()
math(EXPR center "17 + (720 * 2560 + 1280) * 3")
set(sum 0)
foreach(channel RANGE 0 2)
    math(EXPR offset "${center} + ${channel}")
    file(READ "${ppm}" hex OFFSET ${offset} LIMIT 1 HEX)
    math(EXPR value "0x${hex}")
    if(value LESS 20)
        message(FATAL_ERROR "Missing PBR mesh at center")
    endif()
    math(EXPR sum "${sum} + ${value}")
endforeach()
if(sum LESS 150 OR sum GREATER 740)
    message(FATAL_ERROR "Invalid PBR shaded color")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}/blocked/output.ppm")
execute_process(COMMAND "${RENDERER}" --snapshot WORKING_DIRECTORY "${TEST_DIR}/blocked"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(result STREQUAL "0" OR NOT stderr MATCHES "Cannot open output.ppm" OR stderr MATCHES "[[]validation error[]]")
    message(FATAL_ERROR "File-error handling failed (${result}):\n${stdout}\n${stderr}")
endif()
foreach(invalid_resolution 1080p 16k)
    execute_process(COMMAND "${RENDERER}" --resolution "${invalid_resolution}" --snapshot
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(result STREQUAL "0" OR NOT stderr MATCHES "--resolution expects 2k, 4k, or 8k")
        message(FATAL_ERROR "Invalid resolution ${invalid_resolution} was not rejected: ${stderr}")
    endif()
endforeach()

execute_process(COMMAND "${RENDERER}" --render-mode invalid --snapshot
    RESULT_VARIABLE result ERROR_VARIABLE stderr)
if(result STREQUAL "0" OR NOT stderr MATCHES "--render-mode expects raster, hybrid, or pathtrace")
    message(FATAL_ERROR "Invalid render mode was not rejected: ${stderr}")
endif()
